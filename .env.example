# Copy to .env and fill in only the services you want to turn on.
# The demo runs with none of these set.

# --- Model ---
# mock (offline, default) | openai | anthropic
LLM_PROVIDER=mock
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LLM_MAX_RETRIES=3

# coi or invoice. Used when a file name does not make the type obvious.
DEFAULT_SCHEMA=coi

# --- Where files and results live ---
WATCH_DIR=inbox
WATCH_ENABLED=false
WATCH_INTERVAL_SECONDS=5
SAMPLES_DIR=samples
DATA_DIR=data
DATABASE_PATH=data/extractor.db
CSV_PATH=data/extractions.csv
REMINDER_PREVIEW_PATH=data/reminder_preview.txt
SCHEMA_DIR=schemas
PROCESS_SAMPLES_ON_START=false

# --- Reminders ---
# Send when the expiry or due date is today or within this many days.
REMINDER_DAYS=30
# true prints the email instead of sending it.
REMINDER_DRY_RUN=true
REMINDER_TO=project-manager@example.com
REMINDER_FROM=reminders@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Daily job runs only when the web service is started with the scheduler on.
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0

# --- Google Sheets (optional) ---
# Share the sheet with the service account email. CSV and SQLite are always written.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Extractions

# --- Inbox polling (optional) ---
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Error alerts (optional) ---
# slack uses {"text": "..."}. telegram posts to sendMessage with TELEGRAM_CHAT_ID.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=slack
TELEGRAM_CHAT_ID=

# --- Scanned PDFs (optional) ---
# Requires the Tesseract binary and: pip install "ai-document-extractor[ocr]"
OCR_ENABLED=false

LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8741
